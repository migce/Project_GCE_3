## PostgreSQL configuration
# DATABASE_URL=postgres://gce3:change_me@localhost:5432/gce3

# Or discrete variables:
# DB_ENGINE=postgres
# DB_NAME=gce3
# DB_USER=gce3
# DB_PASSWORD=change_me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Optional
# DB_SSLMODE=prefer      # require | disable | verify-ca | verify-full
# DB_CONNECT_TIMEOUT=10  # seconds

## Legacy dev default is SQLite; no vars needed.
